<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/account_title"
            android:textColor="@color/color_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/account_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/avatar_pick_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/img_account_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@color/color_input_bg"
                    android:contentDescription="@string/account_avatar"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Avatar" />

                <Button
                    android:id="@+id/btn_pick_avatar"
                    style="@style/Button.AccountAction"
                    android:layout_marginStart="16dp"
                    android:text="@string/account_pick_avatar" />
            </LinearLayout>

            <EditText
                android:id="@+id/input_username"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_rounded"
                android:hint="@string/account_username_hint"
                android:inputType="text"
                android:maxLength="20"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/input_password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_rounded"
                android:hint="@string/account_password_hint"
                android:inputType="textPassword"
                android:maxLength="32"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/color_on_surface"
                android:textColorHint="@color/color_text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/text_account_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/color_wrong"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_account_submit"
                style="@style/Button.AccountAction"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/account_login" />

            <TextView
                android:id="@+id/text_account_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:padding="6dp"
                android:text="@string/account_to_register"
                android:textColor="@color/purple_500"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/account_logged"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_logged_avatar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:background="@color/color_input_bg"
                android:contentDescription="@string/account_avatar"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Avatar" />

            <TextView
                android:id="@+id/text_logged_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/color_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_change_avatar"
                style="@style/Button.AccountOutlined"
                android:layout_marginTop="20dp"
                android:text="@string/account_change_avatar" />

            <Button
                android:id="@+id/btn_account_logout"
                style="@style/Button.AccountOutlined"
                android:layout_marginTop="10dp"
                android:text="@string/account_logout" />

            <TextView
                android:id="@+id/text_account_close"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:padding="6dp"
                android:text="@string/account_close"
                android:textColor="@color/purple_500"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>